%%{init: {"theme": "redux-color"}}%%
sequenceDiagram
    actor WorkshopOwner as Workshop Owner
    participant UI as Service Ride Interface
    participant Service as Application Service
    participant Records as Service Ride Records
    WorkshopOwner->>UI: Select a reporting period and workshop
    UI->>Service: Submit workshop revenue report request
    Service->>Records: Check owner access and matching transactions
    Records-->>Service: Return current records and validation result
    alt Request satisfies the business rules
        Service->>Records: Aggregate cash and online transaction totals
        Records-->>Service: Confirm the saved or calculated result
        Service-->>UI: Display the workshop revenue report
        UI-->>WorkshopOwner: Display the result and next step
    else Request needs correction or review
        Service-->>UI: Exclude transactions outside the owner scope
        UI-->>WorkshopOwner: Display the reason and required action
    end
