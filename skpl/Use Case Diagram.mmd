%%{init: {"theme": "redux-color"}}%%
usecase-beta
 direction LR

actor SuperAdmin("Super Admin")
actor Customer("Customer")
actor WorkshopOwner("Workshop Owner")
actor WarehouseAdmin("Workshop Warehouse Administrator")
actor OpsAdmin("Workshop Operations Administrator")
actor Mechanic("Mechanic")
actor PickupService("Pickup Service")

systemBoundary ServiceRide["Service Ride"]@{ type: package }:::system
    Login("Account Login")
    Register("Account Registration")
    Verify("Account Verification")

    RegisterWorkshop("Register Workshop or Branch")
    VerifyWorkshop("Verify Workshop Legal Documents")
    EmployeeManagement("Manage Employees and Branch Access")

    ManagementProduct("Manage Spare Part Catalog")
    ManageInventory("Manage Workshop Inventory Units")
    OrderProductOnsite("Record Offline Spare Part Sale")
    OrderProductMarketplace("Order Spare Part on Marketplace")
    ConfirmOrder("Process and Confirm Order")
    CancelOrder("Cancel Marketplace Order")
    ReturnOrder("Request and Review Marketplace Return")

    ManageVehicle("Manage Vehicle")
    BookingServiceOnsite("Book Service at Workshop")
    BookingServicePickup("Book Service with Pickup")
    OfflineService("Register Full Offline Service")
    ConfirmBooking("Confirm Booking or Manage Queue")
    CancelBooking("Cancel Booking")
    ViewOrderBookingStatus("View Order and Service Status")
    AssignTechnician("Assign Technician")
    TrackPickup("Track Pickup and Handover")

    VehicleInspectionService("Inspect Vehicle and Prepare Cost Estimate")
    CheckEstimateStock("Check Workshop Stock for Estimate")
    ConfirmEstimateCost("Approve or Reject Estimate")
    ConfirmComplete("Complete Service and Record Evidence")
    PickupVehicleService("Pick Up Vehicle for Service")
    ReturnVehicleService("Return Vehicle After Service")

    Payment("Pay for Pickup, Service, or Order")
    RecordCashPayment("Record Cash Payment")
    ConfirmPayment("Confirm Payment")
    Invoice("Generate Final Invoice")

    ReviewTransaction("Review Completed Transaction")
    ManageComplaint("Handle Complaint or Mediate Dispute")
    ManagePlatform("Manage Platform Data and Promotions")
end

SuperAdmin --> Login
SuperAdmin --> VerifyWorkshop
SuperAdmin --> ConfirmPayment
SuperAdmin --> ManageComplaint
SuperAdmin --> ManagePlatform

WorkshopOwner --> Login
WorkshopOwner --> RegisterWorkshop
WorkshopOwner --> EmployeeManagement
WorkshopOwner --> ManageComplaint

WarehouseAdmin --> Login
WarehouseAdmin --> ManagementProduct
WarehouseAdmin --> ManageInventory
WarehouseAdmin --> OrderProductOnsite
WarehouseAdmin --> ConfirmOrder
WarehouseAdmin --> ReturnOrder

OpsAdmin --> Login
OpsAdmin --> BookingServiceOnsite
OpsAdmin --> BookingServicePickup
OpsAdmin --> OfflineService
OpsAdmin --> ConfirmBooking
OpsAdmin --> AssignTechnician
OpsAdmin --> PickupVehicleService
OpsAdmin --> ReturnVehicleService
OpsAdmin --> RecordCashPayment
OpsAdmin --> Invoice
OpsAdmin --> ManageComplaint

Mechanic --> Login
Mechanic --> VehicleInspectionService
Mechanic --> ConfirmComplete

PickupService --> Login
PickupService --> TrackPickup

Customer --> Login
Customer --> Register
Customer --> ManageVehicle
Customer --> OrderProductMarketplace
Customer --> CancelOrder
Customer --> ReturnOrder
Customer --> BookingServiceOnsite
Customer --> BookingServicePickup
Customer --> CancelBooking
Customer --> ViewOrderBookingStatus
Customer --> TrackPickup
Customer --> ConfirmEstimateCost
Customer --> Payment
Customer --> ReviewTransaction
Customer --> ManageComplaint

Register ..> : include Verify
VerifyWorkshop ..> : extend RegisterWorkshop
ManageInventory ..> : extend ManagementProduct
CheckEstimateStock ..> : extend VehicleInspectionService
ConfirmOrder ..> : extend OrderProductOnsite
ConfirmOrder ..> : extend OrderProductMarketplace
CancelOrder ..> : extend OrderProductMarketplace
ReturnOrder ..> : extend OrderProductMarketplace
ConfirmBooking ..> : extend BookingServiceOnsite
ConfirmBooking ..> : extend BookingServicePickup
ConfirmBooking ..> : extend OfflineService
CancelBooking ..> : extend BookingServiceOnsite
CancelBooking ..> : extend BookingServicePickup
BookingServiceOnsite ..> : include ManageVehicle
BookingServicePickup ..> : include ManageVehicle
PickupVehicleService ..> : extend BookingServicePickup
ReturnVehicleService ..> : extend BookingServicePickup
TrackPickup ..> : extend PickupVehicleService
TrackPickup ..> : extend ReturnVehicleService
AssignTechnician ..> : extend ConfirmBooking
ConfirmEstimateCost ..> : extend VehicleInspectionService
ConfirmComplete ..> : extend VehicleInspectionService
RecordCashPayment ..> : extend Payment
ConfirmPayment ..> : extend Payment
Invoice ..> : extend ConfirmPayment
