swimlane-beta TB
  subgraph Customer["Customer"]
    start([Start])
    code[Submit verification code]
    retry[Request or enter new code]
  end

  subgraph System["System"]
    send[Send verification code]
    check[Validate code and expiration]
    valid{Code valid?}
    activate[Mark account verified]
    fail[Show verification failure]
    finish((End))
  end

  start --> send --> code --> check --> valid
  valid -->|No| fail --> retry --> code
  valid -->|Yes| activate --> finish
