swimlane-beta TB
  subgraph WorkshopOperationalAdministrator["Workshop Operations Administrator"]
    start([Start])
    review[Review booking and capacity]
    decision{Can accept booking?}
    reason[Record rejection reason]
  end

  subgraph System["System"]
    load[Load pending booking]
    confirm[Confirm booking and reserve slot]
    reject[Reject booking request]
    notify[Notify user]
    finish((End))
  end

  start --> load --> review --> decision
  decision -->|Yes| confirm --> notify --> finish
  decision -->|No| reason --> reject --> notify
