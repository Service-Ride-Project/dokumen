swimlane-beta TB
  subgraph AllRoles["All Roles"]
    start([Start])
    credentials[Enter account credentials]
    retry[Correct credentials and try again]
  end

  subgraph System["System"]
    validate[Validate credentials and assigned role]
    valid{Credentials valid?}
    active{Account active?}
    session[Create role-based session]
    error[Show login error]
    blocked[Show account status]
    finish((End))
  end

  start --> credentials --> validate --> valid
  valid -->|No| error --> retry --> credentials
  valid -->|Yes| active
  active -->|No| blocked --> finish
  active -->|Yes| session --> finish
