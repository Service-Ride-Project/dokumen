swimlane-beta TB
  subgraph SuperAdmin["Super Admin"]
    start([Start])
    review[Review payment transaction if manual verification needed]
    decision{Payment valid?}
  end

  subgraph System["System"]
    load[Retrieve payment proof and gateway status]
    confirmed[Set payment status to confirmed]
    flag[Flag payment for follow-up]
    notify[Notify relevant parties]
    done((Done))
  end

  start --> load --> review --> decision
  decision -->|Yes| confirmed --> notify --> done
  decision -->|No| flag --> notify
