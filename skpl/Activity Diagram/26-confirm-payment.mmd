%%{init: {"theme": "redux-color"}}%%
swimlane-beta TB
  subgraph SuperAdmin["Super Admin"]
    start([Start])
    review[Review transaction only when manual follow-up is required]
    decision{Payment evidence or result is valid?}
  end

  subgraph System["System"]
    load[Retrieve payment record, proof, and Dummy QRIS result]
    confirmed[Set payment status to confirmed and preserve audit trail]
    flag[Flag transaction for follow-up; do not mark it paid]
    notify[Notify relevant parties]
    finish((End))
  end

  start --> load --> review --> decision
  decision -->|Yes| confirmed --> notify --> finish
  decision -->|No| flag --> notify --> finish
