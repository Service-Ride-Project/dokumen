%%{init: {"theme": "redux-color"}}%%
swimlane-beta TB
  subgraph WorkshopWarehouse["Workshop Warehouse Administrator"]
    start([Start])
    add[Select spare parts and quantities for offline sale]
    revise[Change items or quantities]
    receive[Record cash received]
  end

  subgraph System["System"]
    scope[Load physical units from this workshop only]
    stock[Check available units; exclude pending stock]
    available{Stock sufficient?}
    reserve[Mark sold units pending and record stock movement]
    shortage[Show stock shortage]
    sale[Save offline sale and payment record]
    finish((End))
  end

  start --> add --> scope --> stock --> available
  available -->|No| shortage --> revise --> add
  available -->|Yes| receive --> reserve --> sale --> finish
