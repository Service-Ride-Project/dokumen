swimlane-beta TB
  subgraph Customer["Customer"]
    start([Start])
    vehicle[Select a saved vehicle]
    workshop[Choose workshop and service date and time]
    retry[Choose another available slot]
  end

  subgraph System["System"]
    check[Check workshop service availability and schedule]
    available{Slot available?}
    draft[Create onsite service booking request]
    error[Show unavailable slot]
    queue[Send booking to workshop Operations Administrator]
    finish((End))
  end

  start --> vehicle --> workshop --> check --> available
  available -->|No| error --> retry --> workshop
  available -->|Yes| draft --> queue --> finish
